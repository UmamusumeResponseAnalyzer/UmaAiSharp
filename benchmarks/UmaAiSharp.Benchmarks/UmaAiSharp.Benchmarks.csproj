<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <ProjectReference Include="../../src/UmaAiSharp.Core/UmaAiSharp.Core.csproj" />
    <ProjectReference Include="../../src/UmaAiSharp.Pioneer/UmaAiSharp.Pioneer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/UmaAiSharp.Tests/Fixtures/training-failure-snapshots.json" Link="Fixtures/training-failure-snapshots.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/UmaAiSharp.Tests/Fixtures/training-construction.json" Link="Fixtures/training-construction.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/UmaAiSharp.Pioneer/Evidence/construction-master.jsonl" Link="Fixtures/construction-master.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/pioneer/*-failure-replay.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
